# Copie este arquivo para .env e preencha os valores
# O .env NUNCA vai para o GitHub (está no .gitignore)

# Chave secreta do Flask (gere uma aleatória em produção)
SECRET_KEY=mude-esta-chave-para-algo-aleatorio

# Banco de dados (Railway injeta isso automaticamente — não precisa preencher no Railway)
# Localmente: deixe em branco para usar SQLite
DATABASE_URL=
